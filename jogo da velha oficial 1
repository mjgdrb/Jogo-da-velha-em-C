
#include <stdio.h>
#include <windows.h>
#include <stdbool.h>
#include <time.h>

// Variáveis Globais
char tabuleiro[3][3] = {{' ',' ',' '},
                        {' ',' ',' '},
                        {' ',' ',' '}};
bool parar = false;
char rodada = 'X';
int jogadas = 0;

// ==========================================
// 1. INTERFACE
// ==========================================
void mostrarTabuleiro(){
    printf("\n   1   2   3\n");
    for(int i = 0; i < 3; i++){
        printf("%d ", i+1);
        for(int j = 0; j < 3; j++){
            printf("[%c] ", tabuleiro[i][j]);
        }
        printf("\n");
    }
}

// ==========================================
// 2. VERIFICAÇÃO DE VITÓRIA
// ==========================================
void validarVitoria(char r){
    if ((tabuleiro[0][0] == r && tabuleiro[0][1] == r && tabuleiro[0][2] == r) ||
        (tabuleiro[1][0] == r && tabuleiro[1][1] == r && tabuleiro[1][2] == r) ||
        (tabuleiro[2][0] == r && tabuleiro[2][1] == r && tabuleiro[2][2] == r) ||
        (tabuleiro[0][0] == r && tabuleiro[1][0] == r && tabuleiro[2][0] == r) || 
        (tabuleiro[0][1] == r && tabuleiro[1][1] == r && tabuleiro[2][1] == r) ||
        (tabuleiro[0][2] == r && tabuleiro[1][2] == r && tabuleiro[2][2] == r) || 
        (tabuleiro[0][0] == r && tabuleiro[1][1] == r && tabuleiro[2][2] == r) ||
        (tabuleiro[0][2] == r && tabuleiro[1][1] == r && tabuleiro[2][0] == r)){

        mostrarTabuleiro();   
        
        if(r == 'X'){
            printf("\n==== VOCE VENCEU! ====\n");
        }
        else{
            printf("\n==== COMPUTADOR VENCEU! ====\n");
        }
        parar = true;
    }
}

// ==========================================
// 3. JOGADA DO JOGADOR
// ==========================================
void jogadaJogador(){
    int linha, coluna;
    bool jogadaValida = false;

    printf("\n=> Seu turno (X)!\n");

    while(!jogadaValida){
        printf("\nInsira a linha: ");
        scanf("%d", &linha);
        linha -= 1;

        printf("Insira a coluna: ");
        scanf("%d", &coluna);
        coluna -= 1;

        // Verifica se a posição é válida e se está vazia
        if((linha >= 0 && linha <= 2) && (coluna >= 0 && coluna <= 2) && (tabuleiro[linha][coluna] == ' ')){
            tabuleiro[linha][coluna] = 'X';
            jogadaValida = true;
        } else {
            printf("\n=== POSICAO INVALIDA OU JA OCUPADA ===\n");
        }
    }
}

// ==========================================
// 4. JOGADA DA MÁQUINA
// ==========================================
void jogadaMaquina(){
    int linha, coluna;

    printf("\n=> Turno do Computador (O)!\n");
    Sleep(2000); // Pausa para simular o computador "pensando"

    do {
        linha = rand() % 3;
        coluna = rand() % 3;
    } while(tabuleiro[linha][coluna] != ' '); // Continua sorteando até achar um espaço vazio

    tabuleiro[linha][coluna] = 'O';
}


// ==========================================
// FUNÇÃO PRINCIPAL
// ==========================================
int main(){
    SetConsoleOutputCP(CP_UTF8);
    srand(time(NULL));
    
    while(!parar){
        mostrarTabuleiro();

        // Verifica de quem é o turno e chama a função correspondente
        if(rodada == 'X'){
            jogadaJogador();
        } else {
            jogadaMaquina();
        }

        jogadas++; // Incrementa o número total de jogadas

        // Verifica se o último a jogar venceu
        validarVitoria(rodada);

        // Se alguém venceu (parar == true), sai do loop
        if(parar){
            break;
        }

        // Verifica se deu empate
        if(jogadas == 9){
            mostrarTabuleiro();
            printf("\n==== EMPATE! ====\n");
            break;
        }

        // Alterna o turno
        rodada = (rodada == 'X') ? 'O' : 'X';
    }
    
    return 0;
}
