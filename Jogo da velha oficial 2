#include <stdio.h> // Biblioteca para funções de entrada e saída (ex: printf, scanf)
#include <windows.h> // Biblioteca para funções do Windows (ex: system("cls"), Sleep)
#include <stdbool.h> // Biblioteca para permitir o uso de variáveis booleanas (true/false)
#include <time.h> // Biblioteca para manipulação de tempo (usada para gerar números aleatórios)

char tabuleiro[3][3]; // Matriz 3x3 que representa o tabuleiro do jogo
bool parar = false; // Variável de controle para encerrar o loop principal (quando alguém vence)
char rodada = 'X'; // Define de quem é o turno inicial (X representa o jogador)
int jogadas = 0; // Contador que armazena o total de jogadas realizadas
int linha = 0; // Variável para armazenar a linha escolhida na jogada
int coluna = 0; // Variável para armazenar a coluna escolhida na jogada
int tempoPc = 1500; // Tempo (em milissegundos) para simular o computador "pensando"
int tempoLeitura = 1200; // Tempo (em milissegundos) para o jogador ler as mensagens de erro

void iniciarTabuleiro(){ // Função responsável por zerar o tabuleiro no início do jogo
    for(int i = 0; i<3; i++){ // Loop para percorrer as linhas da matriz
        for(int j = 0; j<3; j++){ // Loop para percorrer as colunas da matriz
            tabuleiro[i][j] = ' '; // Preenche cada espaço com um caractere vazio
        }
    }
}

void mostrarTabuleiro(){ // Função responsável por desenhar o tabuleiro na tela
    printf("\n   1   2   3\n"); // Imprime o cabeçalho numerado para guiar as colunas
    for(int i = 0; i < 3; i++){ // Loop que percorre as linhas
        printf("%d ", i+1); // Imprime o número da linha ao lado esquerdo
        for(int j = 0; j < 3; j++){ // Loop que percorre as colunas
            printf("[%c] ", tabuleiro[i][j]); // Imprime o que está armazenado na matriz (X, O ou vazio)
        }
        printf("\n"); // Quebra a linha após imprimir todas as colunas de uma linha
    }
}

void validarVitoria(char r){ // Função que checa todas as possibilidades de alguém vencer
    for (int i = 0; i < 3; i++) {
        // Verifica se todas as três posições de uma mesma linha têm o símbolo do turno (r)
        if (tabuleiro[i][0] == r && tabuleiro[i][1] == r && tabuleiro[i][2] == r) parar = true;
        // Verifica se todas as três posições de uma mesma coluna têm o símbolo do turno (r)
        if (tabuleiro[0][i] == r && tabuleiro[1][i] == r && tabuleiro[2][i] == r) parar = true;
    }
    // Verifica a vitória na diagonal principal
    if (tabuleiro[0][0] == r && tabuleiro[1][1] == r && tabuleiro[2][2] == r) parar = true;
    // Verifica a vitória na diagonal secundária
    if (tabuleiro[0][2] == r && tabuleiro[1][1] == r && tabuleiro[2][0] == r) parar = true;

    if (parar) { // Se a variável 'parar' ficou verdadeira, houve um vencedor
        system("cls"); // Limpa a tela para exibir o tabuleiro final
        printf("*** JOGO DA VELHA ***");
        mostrarTabuleiro(); // Imprime o tabuleiro pela última vez
        if (r == 'X') { // Se o símbolo vencedor for o do jogador
            printf("\n==== VOCE (X) VENCEU! ====\n");
        } else { // Se o símbolo vencedor for o do computador
            printf("\n==== O COMPUTADOR (O) VENCEU! ====\n");
        }
    }
}

int main(){ // Função principal onde a execução do programa começa
    SetConsoleOutputCP(CP_UTF8); // Configura o terminal para aceitar acentuação corretamente
    iniciarTabuleiro(); // Chama a função para preparar o tabuleiro com espaços em branco
    srand(time(NULL)); // Inicializa a semente aleatória baseada no horário atual
    
    while(!parar){ // Loop infinito do jogo, roda enquanto ninguém ganhar (parar for false)
        system("cls"); // Limpa a tela no início de toda rodada
        
        printf("*** JOGO DA VELHA ***");
        mostrarTabuleiro(); // Mostra como o tabuleiro está no momento

        if(rodada == 'X'){ // Checa se é a vez do jogador humano
            printf("\n=> Seu turno (X)!\n");

            printf("Insira a linha: ");
            scanf("%d", &linha); // Lê a linha digitada pelo usuário
            linha -= 1; // Subtrai 1 para adequar ao índice da matriz (que vai de 0 a 2)

            printf("Insira a coluna: ");
            scanf("%d", &coluna); // Lê a coluna digitada pelo usuário
            coluna -= 1; // Subtrai 1 para adequar ao índice da matriz

            // Verifica se o usuário digitou uma coordenada que não existe no tabuleiro
            if((linha < 0) || (linha > 2) || (coluna < 0) || (coluna > 2)){
                printf("\n=== POSICAO INVALIDA ===\n");
                Sleep(tempoLeitura); // Pausa para o usuário ler o erro
                continue; // Pula o resto do código e reinicia o loop (pede a jogada de novo)
            }
            // Verifica se a coordenada escolhida já tem um 'X' ou um 'O'
            if(tabuleiro[linha][coluna] != ' '){
                printf("\n=== POSICAO JA OCUPADA ===\n");
                Sleep(tempoLeitura); // Pausa para o usuário ler o erro
                continue; // Pula o resto do código e reinicia o loop
            }
        }
        else { // Caso contrário, é o turno do computador ('O')
            printf("\n=> Turno do Computador (O)...\n");
            Sleep(tempoPc); // Pausa a tela simulando que o computador está pensando

            do{ // Inicia um loop para o computador escolher uma casa aleatória
                linha = rand() % 3; // Sorteia uma linha aleatória entre 0 e 2
                coluna = rand() % 3; // Sorteia uma coluna aleatória entre 0 e 2
            }while(tabuleiro[linha][coluna] != ' '); // Repete o sorteio até encontrar um espaço vazio
        }

        tabuleiro[linha][coluna] = rodada; // Registra a jogada (X ou O) na matriz
        jogadas++; // Aumenta o contador de jogadas no total

        validarVitoria(rodada); // Verifica se a jogada que acabou de ser feita rendeu uma vitória

        if(parar){ // Se a função validarVitoria declarou um ganhador, 'parar' vira true
            break; // Quebra o loop principal e finaliza o jogo
        }

        if(jogadas == 9){ // Se todas as 9 casas do tabuleiro foram preenchidas e ninguém venceu
            system("cls"); // Limpa a tela
            printf("*** JOGO DA VELHA ***");
            mostrarTabuleiro(); // Mostra o tabuleiro final
            printf("\n==== EMPATE! ====\n"); // Informa que deu empate
            break; // Quebra o loop principal e finaliza o jogo
        }

        // Alterna o turno: se rodada atual for 'X', muda para 'O'. Se não, muda para 'X'
        rodada = (rodada == 'X') ? 'O' : 'X';
    }
    
    return 0; // Finaliza o programa retornando 0 (sucesso)
}
